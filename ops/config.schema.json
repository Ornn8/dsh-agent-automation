{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Agent Automation operations configuration",
  "type": "object",
  "required": ["schemaVersion", "configRevision", "credentialRevision", "repositories", "ghExecutable", "gitExecutable", "github", "workers", "maintenanceWorkers", "maintenanceReviewWorker", "operations"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "configRevision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "credentialRevision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repository" }
    },
    "ghExecutable": { "type": "string", "minLength": 1 },
    "gitExecutable": { "type": "string", "minLength": 1 },
    "github": {
      "type": "object",
      "required": ["login"],
      "properties": {
        "login": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" }
      }
    },
    "workers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["adapter", "capabilities"],
        "properties": {
          "adapter": { "type": "string", "minLength": 1 },
          "credentialIsolationDir": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
          "githubLogin": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
          "capabilities": {
            "type": "object",
            "required": ["skills", "hardReadOnlyReview", "trustDomain"],
            "additionalProperties": false,
            "properties": {
              "skills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "hardReadOnlyReview": { "type": "boolean" },
              "trustDomain": { "enum": ["change", "review", "maintenance"] }
            }
          }
        },
        "allOf": [{
          "if": { "properties": { "capabilities": { "properties": { "trustDomain": { "const": "maintenance" } }, "required": ["trustDomain"] } }, "required": ["capabilities"] },
          "then": { "required": ["credentialIsolationDir", "githubLogin"] }
        }, {
          "if": { "properties": { "adapter": { "const": "dsh-web" } }, "required": ["adapter"] },
          "then": {
            "required": ["baseUrl", "agentPreset", "permissionPreset", "provider", "model", "reasoningEffort"],
            "properties": {
              "baseUrl": { "type": "string", "minLength": 1 },
              "agentPreset": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
              "permissionPreset": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "reasoningEffort": { "type": "string", "minLength": 1 }
            }
          }
        }, {
          "if": { "properties": { "adapter": { "const": "codex-app" } }, "required": ["adapter"] },
          "then": {
            "required": ["node", "script", "home", "model", "effort", "keep"],
            "properties": {
              "node": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
              "script": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
              "home": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
              "model": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
              "effort": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
              "keep": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          }
        }, {
          "if": { "properties": { "adapter": { "const": "opencode-cli" } }, "required": ["adapter"] },
          "then": {
            "required": ["executable", "mode", "model", "variant"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["change", "review", "maintenance"] },
              "model": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
              "variant": { "type": "string", "minLength": 1 },
              "agent": { "type": "string", "minLength": 1 }
            },
            "allOf": [{
              "if": { "properties": { "mode": { "const": "review" } }, "required": ["mode"] },
              "then": {
                "required": ["gitExecutable"],
                "properties": { "gitExecutable": { "type": "string", "minLength": 1 } }
              }
            }]
          }
        }, {
          "if": { "properties": { "adapter": { "const": "claude-code-cli" } }, "required": ["adapter"] },
          "then": {
            "required": ["executable", "mode", "model", "effort"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["change", "review", "maintenance"] },
              "model": { "type": "string", "minLength": 1 },
              "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultracode"] }
            },
            "allOf": [{
              "if": { "properties": { "mode": { "const": "review" } }, "required": ["mode"] },
              "then": {
                "required": ["gitExecutable"],
                "properties": { "gitExecutable": { "type": "string", "minLength": 1 } }
              }
            }]
          }
        }, {
          "if": { "properties": { "adapter": { "const": "command-json" } }, "required": ["adapter"] },
          "then": {
            "required": ["executable", "mode"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["change", "review", "maintenance"] },
              "args": { "type": "array", "items": { "type": "string" } },
              "healthArgs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }]
      }
    },
    "maintenanceWorkers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "maintenanceReviewWorker": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "object",
      "required": ["schemaVersion", "installRoot", "stateRoot", "logsRoot", "controller", "runner", "repositoryMappings", "roles", "dshWebHost"],
      "properties": {
        "schemaVersion": { "const": 4 },
        "installRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
        "stateRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
        "logsRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
        "controller": {
          "type": "object",
          "required": ["repository", "registrationScope"],
          "properties": {
            "repository": { "$ref": "#/$defs/repository" },
            "registrationScope": { "enum": ["organization", "target-repositories"] },
            "organization": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
          }
        },
        "runner": {
          "type": "object",
          "required": ["version", "artifacts"],
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "artifacts": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "windows-x64": { "$ref": "#/$defs/runnerArtifact" },
                "windows-arm64": { "$ref": "#/$defs/runnerArtifact" },
                "linux-x64": { "$ref": "#/$defs/runnerArtifact" },
                "linux-arm64": { "$ref": "#/$defs/runnerArtifact" },
                "macos-x64": { "$ref": "#/$defs/runnerArtifact" },
                "macos-arm64": { "$ref": "#/$defs/runnerArtifact" }
              }
            }
          }
        },
        "repositoryMappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["repository", "changeWorker", "reviewWorker", "ciWorkflows", "requiredChecks"],
            "additionalProperties": false,
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "changeWorker": { "type": "string", "minLength": 1 },
              "reviewWorker": { "type": "string", "minLength": 1 },
              "ciWorkflows": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$" } },
              "requiredChecks": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$" } }
            }
          }
        },
        "roles": {
          "type": "object",
          "required": ["change", "review", "maintenance"],
          "additionalProperties": false,
          "properties": {
            "change": { "$ref": "#/$defs/role" },
            "review": { "$ref": "#/$defs/role" },
            "maintenance": {
              "allOf": [
                { "$ref": "#/$defs/role" },
                { "properties": { "replicas": { "const": 1 } } }
              ]
            }
          }
        },
        "dshWebHost": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "executable": { "type": "string", "minLength": 1 },
            "arguments": { "type": "array", "items": { "type": "string" } },
            "workingDirectory": { "type": "string", "minLength": 1 },
            "baseUrl": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?$" },
            "healthPath": { "const": "/api/session.list" },
            "restartAfterFailures": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "runnerArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloadUri", "sha256"],
      "properties": {
        "downloadUri": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^(?:[A-Fa-f0-9]{64}|REPLACE_WITH_THE_OFFICIAL_64_CHARACTER_SHA256)$" }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "role": {
      "type": "object",
      "required": ["runnerNamePrefix", "labels"],
      "additionalProperties": false,
      "properties": {
        "runnerNamePrefix": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Za-z0-9_.-]+$" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 8, "default": 1 },
        "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" } }
      }
    }
  }
}
