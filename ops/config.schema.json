{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Agent Automation operations configuration",
  "type": "object",
  "required": ["schemaVersion", "repositories", "ghExecutable", "gitExecutable", "github", "workers", "operations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repository" }
    },
    "ghExecutable": { "type": "string", "minLength": 1 },
    "gitExecutable": { "type": "string", "minLength": 1 },
    "github": {
      "type": "object",
      "required": ["login"],
      "properties": {
        "login": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" }
      }
    },
    "workers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "allOf": [{
          "if": { "properties": { "adapter": { "const": "dsh-web" } }, "required": ["adapter"] },
          "then": {
            "required": ["baseUrl", "provider", "model", "reasoningEffort"],
            "properties": {
              "baseUrl": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "reasoningEffort": { "type": "string", "minLength": 1 }
            }
          }
        }, {
          "if": { "properties": { "adapter": { "const": "opencode-cli" } }, "required": ["adapter"] },
          "then": {
            "required": ["executable", "mode", "model", "variant"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["change", "review"] },
              "model": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
              "variant": { "type": "string", "minLength": 1 },
              "agent": { "type": "string", "minLength": 1 }
            },
            "allOf": [{
              "if": { "properties": { "mode": { "const": "review" } }, "required": ["mode"] },
              "then": {
                "required": ["gitExecutable"],
                "properties": { "gitExecutable": { "type": "string", "minLength": 1 } }
              }
            }]
          }
        }, {
          "if": { "properties": { "adapter": { "const": "claude-code-cli" } }, "required": ["adapter"] },
          "then": {
            "required": ["executable", "mode", "model", "effort"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["change", "review"] },
              "model": { "type": "string", "minLength": 1 },
              "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultracode"] }
            },
            "allOf": [{
              "if": { "properties": { "mode": { "const": "review" } }, "required": ["mode"] },
              "then": {
                "required": ["gitExecutable"],
                "properties": { "gitExecutable": { "type": "string", "minLength": 1 } }
              }
            }]
          }
        }]
      }
    },
    "operations": {
      "type": "object",
      "required": ["schemaVersion", "installRoot", "stateRoot", "logsRoot", "controller", "runner", "repositoryMappings", "roles", "dshWebHost"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "installRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
        "stateRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
        "logsRoot": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
        "controller": {
          "type": "object",
          "required": ["repository", "registrationScope"],
          "properties": {
            "repository": { "$ref": "#/$defs/repository" },
            "registrationScope": { "enum": ["organization", "target-repositories"] },
            "organization": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
          }
        },
        "runner": {
          "type": "object",
          "required": ["version", "downloadUri", "sha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "downloadUri": { "type": "string", "pattern": "^https://" },
            "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
          }
        },
        "repositoryMappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["repository", "changeWorker", "reviewWorker", "ciWorkflowName", "ciRequiredCheckName"],
            "additionalProperties": false,
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "changeWorker": { "type": "string", "minLength": 1 },
              "reviewWorker": { "type": "string", "minLength": 1 },
              "ciWorkflowName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$" },
              "ciRequiredCheckName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$" }
            }
          }
        },
        "roles": {
          "type": "object",
          "required": ["change", "review"],
          "additionalProperties": false,
          "properties": {
            "change": { "$ref": "#/$defs/role" },
            "review": { "$ref": "#/$defs/role" }
          }
        },
        "dshWebHost": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "executable": { "type": "string", "minLength": 1 },
            "arguments": { "type": "array", "items": { "type": "string" } },
            "workingDirectory": { "type": "string", "minLength": 1 },
            "baseUrl": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?$" },
            "healthPath": { "const": "/api/session.list" },
            "restartAfterFailures": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "role": {
      "type": "object",
      "required": ["runnerNamePrefix", "labels"],
      "additionalProperties": false,
      "properties": {
        "runnerNamePrefix": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Za-z0-9_.-]+$" },
        "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" } }
      }
    }
  }
}
