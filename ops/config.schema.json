{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Automation machine configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["credentialGeneration", "github", "workers", "operations"],
  "properties": {
    "$schema": { "type": "string" },
    "credentialGeneration": { "$ref": "#/$defs/identifier" },
    "ghExecutable": { "type": "string", "minLength": 1 },
    "gitExecutable": { "type": "string", "minLength": 1 },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login"],
      "properties": {
        "login": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" }
      }
    },
    "workers": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "$ref": "#/$defs/worker" }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "runner", "repositoryMappings", "roles"],
      "properties": {
        "installRoot": { "$ref": "#/$defs/absolutePath" },
        "stateRoot": { "$ref": "#/$defs/absolutePath" },
        "logsRoot": { "$ref": "#/$defs/absolutePath" },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "$ref": "#/$defs/repository" },
            "registrationScope": { "enum": ["organization", "target-repositories"] },
            "organization": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "artifacts"],
          "properties": {
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "artifacts": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "windows-x64": { "$ref": "#/$defs/runnerArtifact" },
                "windows-arm64": { "$ref": "#/$defs/runnerArtifact" },
                "linux-x64": { "$ref": "#/$defs/runnerArtifact" },
                "linux-arm64": { "$ref": "#/$defs/runnerArtifact" },
                "macos-x64": { "$ref": "#/$defs/runnerArtifact" },
                "macos-arm64": { "$ref": "#/$defs/runnerArtifact" }
              }
            }
          }
        },
        "repositoryMappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "ciWorkflows", "requiredChecks"],
            "properties": {
              "repository": { "$ref": "#/$defs/repository" },
              "ciWorkflows": { "$ref": "#/$defs/nameList" },
              "requiredChecks": { "$ref": "#/$defs/nameList" }
            }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["change", "review", "maintenance"],
          "properties": {
            "change": { "$ref": "#/$defs/role" },
            "review": { "$ref": "#/$defs/role" },
            "maintenance": {
              "allOf": [
                { "$ref": "#/$defs/role" },
                { "properties": { "replicas": { "const": 1 } } }
              ]
            }
          }
        },
        "dshWebHost": { "$ref": "#/$defs/dshWebHost" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]:\\\\|/|\\$\\{CONFIG_DIR\\})"
    },
    "nameList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\r\\n]+$" }
    },
    "runnerArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloadUri", "sha256"],
      "properties": {
        "downloadUri": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^(?:[A-Fa-f0-9]{64}|REPLACE_WITH_THE_OFFICIAL_64_CHARACTER_SHA256)$" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers"],
      "properties": {
        "workers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "runnerNamePrefix": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Za-z0-9_.-]+$" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 8 },
        "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" } }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": { "enum": ["dsh-web", "codex-app", "opencode-cli", "claude-code-cli", "command-json"] },
        "baseUrl": { "type": "string", "minLength": 1 },
        "agentPreset": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
        "permissionPreset": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
        "script": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
        "home": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
        "projectCwd": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n`]+$" },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultracode"] },
        "keep": { "type": "integer", "minimum": 1, "maximum": 100 },
        "executable": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "credentialIsolationDir": { "$ref": "#/$defs/absolutePath" },
        "args": { "type": "array", "items": { "type": "string" } },
        "healthArgs": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "dsh-web" } } },
          "then": { "required": ["baseUrl", "agentPreset", "permissionPreset", "provider", "model", "reasoningEffort"] }
        },
        {
          "if": { "properties": { "adapter": { "const": "codex-app" } } },
          "then": { "required": ["node", "script", "home", "model", "effort", "keep"] }
        },
        {
          "if": { "properties": { "adapter": { "const": "opencode-cli" } } },
          "then": { "required": ["model", "variant"] }
        },
        {
          "if": { "properties": { "adapter": { "const": "claude-code-cli" } } },
          "then": { "required": ["model", "effort"] }
        },
        {
          "if": { "properties": { "adapter": { "const": "command-json" } } },
          "then": { "required": ["executable"] }
        }
      ]
    },
    "dshWebHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "executable": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?$" },
        "restartAfterFailures": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["executable", "arguments", "workingDirectory", "baseUrl"] }
        }
      ]
    }
  }
}
