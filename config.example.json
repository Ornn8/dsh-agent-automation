{
  "$schema": "https://raw.githubusercontent.com/Ornn8/dsh-agent-automation/master/ops/config.schema.json",
  "schemaVersion": 4,
  "configRevision": "config-1",
  "credentialRevision": "credential-1",
  "repositories": ["Ornn8/deepseek-harness"],
  "ghExecutable": "gh.exe",
  "gitExecutable": "git.exe",
  "github": {
    "login": "Ornn8"
  },
  "workers": {
    "dsh": {
      "adapter": "dsh-web",
      "baseUrl": "http://127.0.0.1:3080",
      "agentPreset": "standard",
      "permissionPreset": "danger-full-access",
      "provider": "opencode-go",
      "model": "deepseek-v4-flash",
      "reasoningEffort": "max",
      "capabilities": {
        "skills": ["github-issue-work", "github-pr-repair", "github-pr-review", "agent-readiness-canary"],
        "hardReadOnlyReview": false,
        "trustDomain": "change"
      }
    },
    "codex": {
      "adapter": "codex-app",
      "node": "X:\\path\\to\\node.exe",
      "script": "X:\\path\\to\\codex.js",
      "home": "X:\\path\\to\\codex-data",
      "projectCwd": "X:\\path\\to\\visible-project",
      "model": "gpt-5.6-sol",
      "effort": "medium",
      "keep": 6,
      "capabilities": {
        "skills": ["github-pr-review", "github-repository-supervision", "agent-readiness-canary"],
        "hardReadOnlyReview": true,
        "trustDomain": "review"
      }
    },
    "opencode-change": {
      "adapter": "opencode-cli",
      "executable": "opencode.exe",
      "mode": "change",
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
      "capabilities": {
        "skills": ["github-issue-work", "github-pr-repair", "agent-readiness-canary"],
        "hardReadOnlyReview": false,
        "trustDomain": "change"
      }
    },
    "opencode-review": {
      "adapter": "opencode-cli",
      "executable": "opencode.exe",
      "gitExecutable": "git.exe",
      "mode": "review",
      "model": "openai/gpt-5",
      "variant": "medium",
      "capabilities": {
        "skills": ["github-pr-review", "github-repository-supervision", "agent-readiness-canary"],
        "hardReadOnlyReview": true,
        "trustDomain": "review"
      }
    },
    "claude-change": {
      "adapter": "claude-code-cli",
      "executable": "claude.exe",
      "mode": "change",
      "model": "opus",
      "effort": "max",
      "capabilities": {
        "skills": ["github-issue-work", "github-pr-repair", "agent-readiness-canary"],
        "hardReadOnlyReview": false,
        "trustDomain": "change"
      }
    },
    "claude-review": {
      "adapter": "claude-code-cli",
      "executable": "claude.exe",
      "gitExecutable": "git.exe",
      "mode": "review",
      "model": "sonnet",
      "effort": "high",
      "capabilities": {
        "skills": ["github-pr-review", "github-repository-supervision", "agent-readiness-canary"],
        "hardReadOnlyReview": true,
        "trustDomain": "review"
      }
    },
    "another-agent": {
      "adapter": "command-json",
      "executable": "X:\\agents\\another-agent.exe",
      "args": ["run-json"],
      "healthArgs": ["health"],
      "mode": "change",
      "capabilities": {
        "skills": ["github-issue-work", "github-pr-repair", "agent-readiness-canary"],
        "hardReadOnlyReview": false,
        "trustDomain": "change"
      }
    },
    "opencode-maintenance": {
      "adapter": "opencode-cli",
      "executable": "opencode.exe",
      "mode": "maintenance",
      "credentialIsolationDir": "F:\\dsh-agent-automation-state\\credentials\\opencode-maintenance-gh",
      "githubLogin": "Ornn8",
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
      "capabilities": {
        "skills": ["controller-maintenance-repair", "agent-readiness-canary"],
        "hardReadOnlyReview": false,
        "trustDomain": "maintenance"
      }
    },
    "claude-maintenance": {
      "adapter": "claude-code-cli",
      "executable": "claude.exe",
      "mode": "maintenance",
      "credentialIsolationDir": "F:\\dsh-agent-automation-state\\credentials\\claude-maintenance-gh",
      "githubLogin": "Ornn8",
      "model": "opus",
      "effort": "max",
      "capabilities": {
        "skills": ["controller-maintenance-repair", "agent-readiness-canary"],
        "hardReadOnlyReview": false,
        "trustDomain": "maintenance"
      }
    }
  },
  "maintenanceWorkers": ["opencode-maintenance", "claude-maintenance"],
  "maintenanceReviewWorker": "codex",
  "operations": {
    "schemaVersion": 4,
    "installRoot": "F:\\dsh-agent-automation-runtime",
    "stateRoot": "F:\\dsh-agent-automation-state",
    "logsRoot": "F:\\dsh-agent-automation-state\\logs",
    "controller": {
      "repository": "Ornn8/dsh-agent-automation",
      "registrationScope": "target-repositories"
    },
    "runner": {
      "version": "2.336.0",
      "artifacts": {
        "windows-x64": {
          "downloadUri": "https://github.com/actions/runner/releases/download/v2.336.0/actions-runner-win-x64-2.336.0.zip",
          "sha256": "REPLACE_WITH_THE_OFFICIAL_64_CHARACTER_SHA256"
        }
      }
    },
    "repositoryMappings": [
      {
        "repository": "Ornn8/deepseek-harness",
        "changeWorker": "dsh",
        "reviewWorker": "codex",
        "ciWorkflows": ["CI"],
        "requiredChecks": ["all checks passed"]
      }
    ],
    "roles": {
      "change": {
        "runnerNamePrefix": "dsh-agent-change",
        "replicas": 4,
        "labels": ["agent-change"]
      },
      "review": {
        "runnerNamePrefix": "dsh-agent-review",
        "replicas": 1,
        "labels": ["agent-reviewer"]
      },
      "maintenance": {
        "runnerNamePrefix": "dsh-agent-maint",
        "replicas": 1,
        "labels": ["agent-maintenance"]
      }
    },
    "dshWebHost": {
      "enabled": true,
      "executable": "X:\\path\\to\\node.exe",
      "arguments": ["X:\\path\\to\\dsh-web-host.mjs", "--host", "127.0.0.1", "--port", "3080"],
      "workingDirectory": "X:\\path\\to\\dsh-web-host-project",
      "baseUrl": "http://127.0.0.1:3080",
      "healthPath": "/api/session.list",
      "restartAfterFailures": 3
    }
  }
}
